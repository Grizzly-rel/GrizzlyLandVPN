From 946e5ffd281d0ab1e71f1e091f1f5774038ffc14 Mon Sep 17 00:00:00 2001
From: GrizzlyLandVPN dev <dev@grizzlyland.local>
Date: Tue, 20 Oct 2026 21:58:47 +0300
Subject: [PATCH] wireguard netstack: make netTun.Close idempotent (sync.Once)
 - double close panicked the process

---
 proxy/wireguard/netstack.go | 31 ++++++++++++++++++++-----------
 1 file changed, 20 insertions(+), 11 deletions(-)

diff --git a/proxy/wireguard/netstack.go b/proxy/wireguard/netstack.go
index cc04f15..96edefb 100644
--- a/proxy/wireguard/netstack.go
+++ b/proxy/wireguard/netstack.go
@@ -18,6 +18,7 @@ import (
 	"regexp"
 	"strconv"
 	"strings"
+	"sync"
 	"syscall"
 	"time"
 
@@ -48,6 +49,12 @@ type netTun struct {
 	mtu            int
 	dnsServers     []netip.Addr
 	hasV4, hasV6   bool
+	// closeOnce защищает от двойного/конкурентного Close: wireguard-go может
+	// вызвать Device.Close из нескольких путей (ошибка чтения TUN в рутине +
+	// очистка аутбаунда), а повторный close(chan) в Go панирует и убивает весь
+	// процесс (наблюдалось как SIGABRT «close of closed channel» в libgojni
+	// при деградации WG-handshake).
+	closeOnce sync.Once
 }
 
 func CreateNetTUN(localAddresses, dnsServers []netip.Addr, mtu int, handleLocal bool) (tun.Device, *Net, *stack.Stack, error) {
@@ -181,19 +188,21 @@ func (tun *netTun) WriteNotify() {
 }
 
 func (tun *netTun) Close() error {
-	tun.stack.RemoveNIC(1)
-	tun.stack.Close()
-	tun.ep.RemoveNotify(tun.notifyHandle)
-	tun.ep.Close()
+	tun.closeOnce.Do(func() {
+		tun.stack.RemoveNIC(1)
+		tun.stack.Close()
+		tun.ep.RemoveNotify(tun.notifyHandle)
+		tun.ep.Close()
 
-	if tun.events != nil {
-		close(tun.events)
-	}
+		if tun.events != nil {
+			close(tun.events)
+		}
 
-	// we don't close incomingPacket, because WriteNotify may be mid-send on it (DNS lookup) and would panic.
-	if tun.closed != nil {
-		close(tun.closed)
-	}
+		// we don't close incomingPacket, because WriteNotify may be mid-send on it (DNS lookup) and would panic.
+		if tun.closed != nil {
+			close(tun.closed)
+		}
+	})
 
 	return nil
 }
-- 
2.47.3

